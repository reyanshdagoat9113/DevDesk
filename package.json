{
  "name": "devdesk",
  "version": "0.1.0",
  "description": "A local-first Electron desktop app for developers",
  "main": "dist/main/index.js",
  "author": "DevDesk",
  "license": "MIT",
  "scripts": {
    "rebuild:native": "node scripts/rebuild-native-electron.mjs",
    "rebuild:native:electron": "node scripts/rebuild-native-electron.mjs --with-pty",
    "rebuild:native:node": "node scripts/ensure-native-modules.mjs",
    "pretest:run": "npm run rebuild:native:node",
    "dev": "npm run rebuild:native:electron && npm run build:main && npm run build:preload && concurrently \"npm run dev:renderer\" \"wait-on http://127.0.0.1:5180 && electron --enable-logging=false .\"",
    "dev:renderer": "vite",
    "build:engine": "npm --prefix ../devdesk-addons/devdesk-engine run build:all",
    "prebuild": "npm run build:engine",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "smoke:engine-packaged": "npm run rebuild:native && npm run build:main && node scripts/smoke-packaged-engine.mjs",
    "test": "vitest --config ./vitest.desktop.config.ts",
    "test:run": "vitest --config ./vitest.desktop.config.ts run",
    "test:renderer": "vitest --config ./vitest.renderer.config.ts",
    "test:renderer:run": "vitest --config ./vitest.renderer.config.ts run",
    "test:engine-ipc": "npm run rebuild:native:node && npm run build:engine && npx vitest --config ./vitest.engine.config.ts run",
    "package:linux:dir": "npm run rebuild:native:electron && npm run build && NODE_NO_WARNINGS=1 electron-builder --linux dir",
    "package:linux": "npm run rebuild:native:electron && npm run build && NODE_NO_WARNINGS=1 electron-builder --linux AppImage deb",
    "verify:linux-package": "npm run package:linux:dir && node scripts/verify-linux-package.mjs",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build:preload": "tsc -p tsconfig.preload.json",
    "lint:architecture": "node scripts/check-architecture.mjs",
    "test:production": "NODE_ENV=production electron .",
    "lint": "eslint \"apps/**/*.ts\" \"apps/**/*.tsx\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^12.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "devdesk-engine": "file:../devdesk-addons/devdesk-engine",
    "fast-glob": "^3.3.3",
    "fuse.js": "^7.3.0",
    "ignore": "^7.0.5",
    "lucide-react": "^0.563.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^15.6.6",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@typescript-eslint/parser": "^8.59.4",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "electron": "^33.4.11",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.7.3",
    "vite": "^6.4.2",
    "vitest": "^1.6.1",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.devdesk.app",
    "productName": "DevDesk",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "apps/renderer/assets/devdesk-logo-top-left-transparent.png"
    },
    "extraResources": [
      {
        "from": "node_modules/devdesk-engine/dist",
        "to": "engine",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/devdesk-engine/node_modules",
        "to": "engine/node_modules",
        "filter": [
          "**/*",
          "!better-sqlite3{,/**}",
          "!bindings{,/**}",
          "!file-uri-to-path{,/**}"
        ]
      },
      {
        "from": "node_modules/better-sqlite3",
        "to": "engine/node_modules/better-sqlite3",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/bindings",
        "to": "engine/node_modules/bindings",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/file-uri-to-path",
        "to": "engine/node_modules/file-uri-to-path",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/devdesk-engine/package.json",
        "to": "engine/package.json"
      }
    ]
  }
}
