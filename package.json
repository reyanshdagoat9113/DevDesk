{
  "name": "devdesk-engine",
  "version": "0.1.0",
  "description": "Fast local code intelligence engine for DevDesk",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./git": "./dist/git.js"
  },
  "bin": {
    "devdesk-engine": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint src/",
    "build:rust": "cd rust && cargo build --release && cd .. && node scripts/copy-binary.cjs",
    "build:all": "npm run build:rust && npm run build"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.11.0",
    "esbuild": "^0.20.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "code-search",
    "indexing",
    "devdesk",
    "code-intelligence"
  ],
  "license": "MIT"
}
