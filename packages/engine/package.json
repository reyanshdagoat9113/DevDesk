{
  "name": "devdesk-engine",
  "version": "0.1.0",
  "description": "Fast local code intelligence engine for DevDesk",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./git": "./dist/git.js"
  },
  "bin": {
    "devdesk-engine": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "ensure:native": "node scripts/ensure-native.cjs",
    "rebuild:native": "npm rebuild better-sqlite3",
    "start": "node dist/cli.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "build:rust": "cd rust && cargo build --release && cd .. && node scripts/copy-binary.cjs",
    "build:all": "npm run build:rust && npm run build"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.19",
    "@vitest/coverage-v8": "^1.6.1",
    "esbuild": "^0.28.0",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  },
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "keywords": [
    "code-search",
    "indexing",
    "devdesk",
    "code-intelligence"
  ],
  "license": "MIT"
}
